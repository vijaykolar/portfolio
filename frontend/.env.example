# --- Site ---
# Public base URL of the deployed site (used for RSS absolute links/images).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Keystatic CMS (GitHub storage mode, used in production) ---
# In development the CMS uses local storage and these are NOT required.
# In production (NODE_ENV=production) the CMS commits to GitHub and these
# MUST be set (locally in .env.local and in your Vercel project settings).
#
# Obtain CLIENT_ID / CLIENT_SECRET by creating a GitHub App via the Keystatic
# onboarding flow: run `npm run dev`, open http://localhost:3000/keystatic,
# and follow "Connect to GitHub" (it pre-fills the app name, homepage, and the
# callback URL /api/keystatic/github/oauth/callback). Grant the app
# "Contents: Read & write" + "Metadata: Read-only" and install it on the repo.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# A random signing secret for auth cookies. Generate with: openssl rand -hex 32
KEYSTATIC_SECRET=
