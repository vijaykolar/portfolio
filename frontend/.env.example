# --- Site ---
# Public base URL of the deployed site (used for RSS absolute links/images).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Keystatic CMS ---
# By default the CMS uses LOCAL storage (edits the filesystem) and needs NO
# secrets — this is what `npm run dev` uses, and it lets the site build on any
# host without configuration.
#
# To author/publish from the DEPLOYED /keystatic admin, switch to GitHub storage
# by setting ALL FOUR of the variables below in your Vercel project (and in
# .env.local for local testing). Leaving NEXT_PUBLIC_KEYSTATIC_STORAGE unset
# keeps local mode and never breaks the build.
NEXT_PUBLIC_KEYSTATIC_STORAGE=github

# Create a GitHub App (GitHub → Settings → Developer settings → GitHub Apps →
# New GitHub App): set the callback URL to
# https://<your-domain>/api/keystatic/github/oauth/callback (add a
# http://127.0.0.1:3000/... variant for local), enable "Request user
# authorization (OAuth) during installation", grant "Contents: Read & write" +
# "Metadata: Read-only", then install it on vijaykolar/portfolio.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# A random signing secret for auth cookies. Generate with: openssl rand -hex 32
KEYSTATIC_SECRET=

# --- Newsletter (SendGrid) ---
# Signups are stored as SendGrid Marketing Contacts and new posts are emailed to
# that list via a SendGrid Single Send. Set these on Vercel for the API routes
# /api/subscribe and /api/notify to work.
#
# API key with BOTH "Mail Send" and "Marketing" permissions:
SENDGRID_API_KEY=
# Marketing contact list ID (Marketing → Contacts → your list → Details):
SENDGRID_LIST_ID=
# Verified single-sender email (used for the optional welcome email on signup):
SENDGRID_FROM_EMAIL=
# Numeric verified sender identity ID for the newsletter Single Send
# (Marketing → Senders, or GET /v3/marketing/senders):
SENDGRID_SENDER_ID=
# Numeric unsubscribe (suppression) group ID for the newsletter
# (Suppressions → Unsubscribe Groups):
SENDGRID_UNSUBSCRIBE_GROUP_ID=
# Shared secret protecting POST /api/notify. Generate with: openssl rand -hex 32
# The auto-poster must send this as `Authorization: Bearer <value>`.
NEWSLETTER_NOTIFY_SECRET=
