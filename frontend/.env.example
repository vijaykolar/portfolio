# --- Site ---
# Public base URL of the deployed site (used for RSS absolute links/images).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Sanity CMS ---
# Posts live in Sanity (free plan). The Studio is embedded at /studio and the
# site reads published posts at build time and on revalidation.
#
# Create a project at https://www.sanity.io/manage (dataset "production",
# visibility PUBLIC so reads need no token), then:
#   API -> CORS origins: add http://localhost:3000 and https://<your-domain>
#   with "Allow credentials" ON (needed for Studio login at /studio).
# Set these two in Vercel (all environments) and in .env.local — the build
# queries Sanity, so they are REQUIRED:
NEXT_PUBLIC_SANITY_PROJECT_ID=ax0g47x9
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the publish webhook (Sanity -> /api/revalidate).
# Generate with: openssl rand -hex 32. Set in Vercel, and in
# sanity.io/manage -> API -> Webhooks:
#   URL https://<your-domain>/api/revalidate, trigger create/update/delete,
#   filter `_type == "post"`, projection `{_type, "slug": slug.current}`,
#   "Include drafts" OFF, secret = this value.
SANITY_REVALIDATE_SECRET=

# Write token (sanity.io/manage -> API -> Tokens, role "Editor").
# ONLY for the GitHub Actions auto-poster (repo secret SANITY_API_WRITE_TOKEN)
# and the one-time local migration script. Never set it on Vercel and never
# prefix it with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# --- Newsletter (SendGrid) ---
# Signups are stored as SendGrid Marketing Contacts and new posts are emailed to
# that list via a SendGrid Single Send. Set these on Vercel for the API routes
# /api/subscribe and /api/notify to work.
#
# API key with BOTH "Mail Send" and "Marketing" permissions:
SENDGRID_API_KEY=
# Marketing contact list ID (Marketing → Contacts → your list → Details):
SENDGRID_LIST_ID=
# Verified single-sender email (used for the optional welcome email on signup):
SENDGRID_FROM_EMAIL=
# Numeric verified sender identity ID for the newsletter Single Send
# (Marketing → Senders, or GET /v3/marketing/senders):
SENDGRID_SENDER_ID=
# Numeric unsubscribe (suppression) group ID for the newsletter
# (Suppressions → Unsubscribe Groups):
SENDGRID_UNSUBSCRIBE_GROUP_ID=
# Shared secret protecting POST /api/notify. Generate with: openssl rand -hex 32
NEWSLETTER_NOTIFY_SECRET=
